# Native configuration directory. Image/workspace/results paths are written by
# `zvec init` to config.json.
ZVEC_CONFIG_HOME=

# Required for embedding/index/search requests.
DASHSCOPE_API_KEY=
# DASHSCOPE_API_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/multimodal-embedding/multimodal-embedding

# Optional visual-understanding endpoint used only by Smart Organize.
# DASHSCOPE_VISION_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions

# Review current Alibaba Cloud pricing before enabling automatic tagging.
# Values are CNY per one million tokens and can be changed without rebuilding.
DASHSCOPE_VISION_FLASH_INPUT_YUAN_PER_MILLION=0.15
DASHSCOPE_VISION_FLASH_OUTPUT_YUAN_PER_MILLION=1.50
DASHSCOPE_VISION_PLUS_INPUT_YUAN_PER_MILLION=1.00
DASHSCOPE_VISION_PLUS_OUTPUT_YUAN_PER_MILLION=10.00
DASHSCOPE_VISION_PRICING_EFFECTIVE_FROM=2026-07-14
