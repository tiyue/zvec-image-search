<Window x:Class="Zvec.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Zvec.Desktop.Controls"
        mc:Ignorable="d"
        Title="Zvec 图片语义搜索"
        Width="1180"
        Height="700"
        MinWidth="660"
        MinHeight="360"
        MaxWidth="{x:Static SystemParameters.MaximizedPrimaryScreenWidth}"
        MaxHeight="{x:Static SystemParameters.MaximizedPrimaryScreenHeight}"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="WorkspaceCardStyle"
               TargetType="Border"
               BasedOn="{StaticResource CardBorderStyle}">
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>

        <Style x:Key="HeaderActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MinWidth" Value="74" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#18FFFFFF" />
            <Setter Property="BorderBrush" Value="#42FFFFFF" />
        </Style>

        <Style x:Key="ToolbarButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="MinHeight" Value="31" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="CompactButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
    </Window.Resources>

    <Grid Margin="12,10,12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Brand and backend state -->
        <Border Grid.Row="0"
                Padding="16,11"
                Background="{StaticResource HeroBrush}"
                CornerRadius="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Margin="0,0,12,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="42"
                            Height="42"
                            Margin="0,0,12,0"
                            Padding="3"
                            Background="#20FFFFFF"
                            BorderBrush="#42FFFFFF"
                            BorderThickness="1"
                            CornerRadius="12">
                        <Image Source="Assets/Zvec.AppIcon.png"
                               Stretch="Uniform"
                               SnapsToDevicePixels="True" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Text="Zvec 图片语义搜索" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="11.5"
                                   Foreground="#D9E8FF"
                                   Text="管理多个 Collection，快速建立索引并进行语义检索"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>

                <Border x:Name="BackendStatusBorder"
                        Grid.Column="1"
                        MaxWidth="236"
                        Padding="10,5"
                        VerticalAlignment="Center"
                        Background="#FFF7ED"
                        BorderBrush="#FED7AA"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7"
                                 Height="7"
                                 Margin="0,0,7,0"
                                 VerticalAlignment="Center"
                                 Fill="{Binding Foreground, ElementName=BackendStatusTextBlock}" />
                        <TextBlock x:Name="BackendStatusTextBlock"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#B45309"
                                   Text="常驻后端未启动"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Configuration context and frequent actions -->
        <Border Grid.Row="1"
                Margin="0,8,0,0"
                Padding="10,7"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="11">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="25"
                        Height="25"
                        VerticalAlignment="Center"
                        Background="{StaticResource PrimarySoftBrush}"
                        CornerRadius="13">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryDarkBrush}"
                               Text="i" />
                </Border>
                <TextBlock x:Name="ConfigurationTextBlock"
                           Grid.Column="1"
                           Margin="9,0,12,0"
                           VerticalAlignment="Center"
                           FontSize="11.5"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="正在读取本机配置…"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel x:Name="HeaderActionsPanel"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Margin="0,0,6,0"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="Doctor_Click"
                            Content="诊断"
                            ToolTip="检查 Python 后端、目录权限与 API Key" />
                    <Button Margin="0,0,6,0"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="Stats_Click"
                            Content="统计"
                            ToolTip="刷新当前 Collection 统计" />
                    <Button Margin="0,0,6,0"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="OpenResults_Click"
                            Content="结果目录"
                            ToolTip="打开搜索结果目录" />
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Click="ExitApplication_Click"
                            Content="退出"
                            ToolTip="完整退出 Zvec；仅关闭窗口会转入系统托盘" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Primary workspace -->
        <TabControl x:Name="MainTabControl"
                    Grid.Row="2"
                    Margin="0,8,0,6"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource TabItemStyle}" />
            </TabControl.Resources>

            <!-- Setup -->
            <TabItem x:Name="LibrarySettingsTabItem"
                     Header="① 图库设置">
                <ScrollViewer Margin="0,9,0,0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <Grid Margin="0,0,2,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.72*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1.28*" />
                        </Grid.ColumnDefinitions>

                        <!-- First-use readiness -->
                        <Border x:Name="FirstUseEnvironmentCard"
                                Grid.Row="0"
                                Grid.ColumnSpan="3"
                                Style="{StaticResource WorkspaceCardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Margin="0,0,8,0"
                                                    Padding="7,3"
                                                    Background="{StaticResource PrimarySoftBrush}"
                                                    CornerRadius="8">
                                                <TextBlock FontSize="10.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource PrimaryDarkBrush}"
                                                           Text="首次使用" />
                                            </Border>
                                            <TextBlock x:Name="EnvironmentSummaryTextBlock"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource SectionTitleTextStyle}"
                                                       Text="正在检查运行环境" />
                                        </StackPanel>
                                        <TextBlock x:Name="EnvironmentActionTextBlock"
                                                   Margin="0,6,0,0"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Text="检测完成后会告诉你下一步需要做什么。"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Top">
                                        <Button x:Name="RepairEnvironmentButton"
                                                MinWidth="142"
                                                Margin="0,0,6,6"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Click="RepairEnvironment_Click"
                                                Content="自动修复运行环境" />
                                        <Button x:Name="RefreshEnvironmentButton"
                                                MinWidth="88"
                                                Margin="0,0,6,6"
                                                Style="{StaticResource QuietButtonStyle}"
                                                Click="RefreshEnvironment_Click"
                                                Content="重新检测" />
                                        <Button MinWidth="78"
                                                Margin="0,0,0,6"
                                                Style="{StaticResource QuietButtonStyle}"
                                                Click="OpenEnvironmentLog_Click"
                                                Content="打开日志" />
                                    </WrapPanel>
                                </Grid>

                                <UniformGrid Margin="0,14,0,0" Columns="3">
                                    <Border x:Name="EnvironmentPythonBorder"
                                            Margin="0,0,7,7"
                                            Padding="11,9"
                                            Background="{StaticResource SurfaceMutedBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabelStyle}"
                                                       Text="Python" />
                                            <TextBlock x:Name="EnvironmentPythonStatusTextBlock"
                                                       Margin="0,2,0,0"
                                                       FontWeight="SemiBold"
                                                       Text="正在检测" />
                                            <TextBlock x:Name="EnvironmentPythonDetailTextBlock"
                                                       Margin="0,3,0,0"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Text="将自动选择合适的解释器"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="EnvironmentDependenciesBorder"
                                            Margin="0,0,7,7"
                                            Padding="11,9"
                                            Background="{StaticResource SurfaceMutedBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabelStyle}"
                                                       Text="运行依赖" />
                                            <TextBlock x:Name="EnvironmentDependenciesStatusTextBlock"
                                                       Margin="0,2,0,0"
                                                       FontWeight="SemiBold"
                                                       Text="正在检测" />
                                            <TextBlock x:Name="EnvironmentDependenciesDetailTextBlock"
                                                       Margin="0,3,0,0"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Text="使用锁定版本安装"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="EnvironmentApiKeyBorder"
                                            Margin="0,0,0,7"
                                            Padding="11,9"
                                            Background="{StaticResource SurfaceMutedBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabelStyle}"
                                                       Text="API Key" />
                                            <TextBlock x:Name="EnvironmentApiKeyStatusTextBlock"
                                                       Margin="0,2,0,0"
                                                       FontWeight="SemiBold"
                                                       Text="正在检测" />
                                            <TextBlock x:Name="EnvironmentApiKeyDetailTextBlock"
                                                       Margin="0,3,0,0"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Text="安全保存在 Windows 凭据管理器"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="EnvironmentImageRootBorder"
                                            Margin="0,0,7,0"
                                            Padding="11,9"
                                            Background="{StaticResource SurfaceMutedBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabelStyle}"
                                                       Text="图片目录" />
                                            <TextBlock x:Name="EnvironmentImageRootStatusTextBlock"
                                                       Margin="0,2,0,0"
                                                       FontWeight="SemiBold"
                                                       Text="待选择" />
                                            <TextBlock x:Name="EnvironmentImageRootDetailTextBlock"
                                                       Margin="0,3,0,0"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Text="请选择现有目录"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="EnvironmentWorkspaceBorder"
                                            Margin="0,0,7,0"
                                            Padding="11,9"
                                            Background="{StaticResource SurfaceMutedBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabelStyle}"
                                                       Text="Workspace" />
                                            <TextBlock x:Name="EnvironmentWorkspaceStatusTextBlock"
                                                       Margin="0,2,0,0"
                                                       FontWeight="SemiBold"
                                                       Text="待设置" />
                                            <TextBlock x:Name="EnvironmentWorkspaceDetailTextBlock"
                                                       Margin="0,3,0,0"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Text="保存 Collection、状态与缓存"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="EnvironmentResultsBorder"
                                            Padding="11,9"
                                            Background="{StaticResource SurfaceMutedBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabelStyle}"
                                                       Text="结果目录" />
                                            <TextBlock x:Name="EnvironmentResultsStatusTextBlock"
                                                       Margin="0,2,0,0"
                                                       FontWeight="SemiBold"
                                                       Text="待设置" />
                                            <TextBlock x:Name="EnvironmentResultsDetailTextBlock"
                                                       Margin="0,3,0,0"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Text="保存每次搜索导出"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Grid Margin="0,11,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="WorkspaceMigrationStatusTextBlock"
                                               Grid.Column="0"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextStyle}"
                                               Text="Workspace：新建图库无需迁移；检测到旧版索引时会提示先备份。"
                                               TextWrapping="Wrap" />
                                    <Button x:Name="BackupMigrationButton"
                                            Grid.Column="1"
                                            MinWidth="104"
                                            Margin="12,0,0,0"
                                            IsEnabled="False"
                                            Style="{StaticResource QuietButtonStyle}"
                                            Click="BackupMigration_Click"
                                            Content="备份与迁移"
                                            ToolTip="检测到旧版 Workspace 时自动启用" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Library navigation -->
                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <Border Style="{StaticResource WorkspaceCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                                               Text="图库" />
                                    <TextBlock Margin="0,4,0,11"
                                               Style="{StaticResource CaptionTextStyle}"
                                               Text="选择图库进行编辑；移除配置不会删除图片或索引。" />

                                    <ListBox x:Name="LibraryListBox"
                                             Height="176"
                                             Margin="0,0,0,10"
                                             Padding="3"
                                             Background="{StaticResource SurfaceMutedBrush}"
                                             BorderBrush="{StaticResource BorderBrush}"
                                             BorderThickness="1"
                                             SelectionChanged="LibraryList_SelectionChanged"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             AutomationProperties.Name="图库列表">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="5,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" MinWidth="0">
                                                        <TextBlock FontSize="12.5"
                                                                   FontWeight="SemiBold"
                                                                   Text="{Binding Name}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Margin="0,3,0,0"
                                                                   FontSize="10.5"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   Text="{Binding ImageRoot}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding ImageRoot}" />
                                                        <TextBlock Margin="0,2,0,0"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   Text="{Binding WorkspaceText}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding WorkspaceText}" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1"
                                                            Margin="7,0,0,0"
                                                            Padding="6,3"
                                                            VerticalAlignment="Center"
                                                            Background="{StaticResource PrimarySoftBrush}"
                                                            CornerRadius="8">
                                                        <TextBlock MaxWidth="66"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource PrimaryDarkBrush}"
                                                                   Text="{Binding StateText}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <WrapPanel Margin="0,0,-6,-6">
                                        <Button MinWidth="62"
                                                Margin="0,0,6,6"
                                                Style="{StaticResource QuietButtonStyle}"
                                                Click="AddLibrary_Click"
                                                Content="新增" />
                                        <Button MinWidth="62"
                                                Margin="0,0,6,6"
                                                Style="{StaticResource QuietButtonStyle}"
                                                Click="EditLibrary_Click"
                                                Content="编辑" />
                                        <Button x:Name="ToggleLibraryButton"
                                                MinWidth="62"
                                                Margin="0,0,6,6"
                                                Style="{StaticResource QuietButtonStyle}"
                                                Click="ToggleLibrary_Click"
                                                Content="停用" />
                                        <Button MinWidth="78"
                                                Margin="0,0,6,6"
                                                Style="{StaticResource QuietButtonStyle}"
                                                Click="SetDefaultLibrary_Click"
                                                Content="设为默认" />
                                        <Button MinWidth="62"
                                                Margin="0,0,6,6"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Click="DeleteLibrary_Click"
                                                Content="移除" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,10,0,0"
                                    Style="{StaticResource InsetBorderStyle}"
                                    Padding="13">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SubsectionTitleTextStyle}"
                                               Text="推荐流程" />
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="25" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="21"
                                                Height="21"
                                                Background="{StaticResource PrimarySoftBrush}"
                                                CornerRadius="11">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="10.5"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryDarkBrush}"
                                                       Text="1" />
                                        </Border>
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Text="配置图库与独立 Workspace" />
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="25" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="21"
                                                Height="21"
                                                Background="{StaticResource PrimarySoftBrush}"
                                                CornerRadius="11">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="10.5"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryDarkBrush}"
                                                       Text="2" />
                                        </Border>
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Text="建立或增量更新索引" />
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="25" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="21"
                                                Height="21"
                                                Background="#DCFCE7"
                                                CornerRadius="11">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="10.5"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource SuccessBrush}"
                                                       Text="3" />
                                        </Border>
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Text="在单图库或全部图库中搜索" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Library editor -->
                        <Border Grid.Row="2"
                                Grid.Column="2"
                                Style="{StaticResource WorkspaceCardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,13">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock x:Name="LibraryEditorTitleText"
                                                   Style="{StaticResource SectionTitleTextStyle}"
                                                   Text="编辑图库" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Text="图片目录只读挂载，Workspace 用于保存 Collection、状态和缓存。" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Padding="8,4"
                                            VerticalAlignment="Top"
                                            Background="#ECFDF5"
                                            CornerRadius="9">
                                        <TextBlock FontSize="10.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="#047857"
                                                   Text="独立 Collection" />
                                    </Border>
                                </Grid>

                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="图库名称" />
                                <TextBox x:Name="SetupLibraryNameTextBox"
                                         Margin="0,0,0,11"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         AutomationProperties.Name="图库名称" />

                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="图片目录（只读）" />
                                <Grid Margin="0,0,0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="7" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SetupImageRootTextBox"
                                             Grid.Column="0"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             TextChanged="EnvironmentPath_TextChanged"
                                             AutomationProperties.Name="图片目录" />
                                    <Button Grid.Column="2"
                                            Style="{StaticResource BrowseButtonStyle}"
                                            Click="BrowseImageRoot_Click"
                                            Content="浏览…" />
                                </Grid>

                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="Workspace（Collection、状态与缓存）" />
                                <Grid Margin="0,0,0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="7" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SetupWorkspaceTextBox"
                                             Grid.Column="0"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             TextChanged="EnvironmentPath_TextChanged"
                                             AutomationProperties.Name="Workspace 目录" />
                                    <Button x:Name="BrowseWorkspaceButton"
                                            Grid.Column="2"
                                            Style="{StaticResource BrowseButtonStyle}"
                                            Click="BrowseWorkspace_Click"
                                            Content="浏览…" />
                                </Grid>

                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="搜索结果目录" />
                                <Grid Margin="0,0,0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="7" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SetupResultsTextBox"
                                             Grid.Column="0"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             TextChanged="EnvironmentPath_TextChanged"
                                             AutomationProperties.Name="搜索结果目录" />
                                    <Button Grid.Column="2"
                                            Style="{StaticResource BrowseButtonStyle}"
                                            Click="BrowseResults_Click"
                                            Content="浏览…" />
                                </Grid>

                                <Expander Margin="0,0,0,11"
                                          Header="高级设置（通常无需修改）"
                                          IsExpanded="False">
                                    <StackPanel Margin="0,9,0,0">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                                   Text="自定义 Python 解释器" />
                                        <TextBox x:Name="SetupPythonExecutableTextBox"
                                                 Margin="0,0,0,5"
                                                 Style="{StaticResource InputTextBoxStyle}"
                                                 TextChanged="PythonExecutable_TextChanged"
                                                 AutomationProperties.Name="Python 解释器路径" />
                                        <TextBlock Style="{StaticResource CaptionTextStyle}"
                                                   Text="默认留空。程序会自动准备隔离运行环境；仅在需要指定现有 Python 时填写。"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Expander>

                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="DashScope API Key" />
                                <PasswordBox x:Name="ApiKeyPasswordBox"
                                             Margin="0,0,0,5"
                                             Style="{StaticResource PasswordInputStyle}"
                                             PasswordChanged="ApiKeyPasswordBox_PasswordChanged"
                                             AutomationProperties.Name="DashScope API Key" />
                                <TextBlock x:Name="ApiKeyStatusTextBlock"
                                           Margin="0,0,0,11"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Text="留空时复用当前用户已保存的 API Key。" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Margin="0,0,14,0"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextStyle}"
                                               Text="API Key 保存在当前用户的 Windows 凭据管理器中。" />
                                    <Button x:Name="SaveLibraryButton"
                                            Grid.Column="1"
                                            MinWidth="136"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="Initialize_Click"
                                            Content="保存图库配置" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- Index -->
            <TabItem x:Name="IndexTabItem"
                     Header="② 建立索引">
                <ScrollViewer Margin="0,9,0,0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <Grid Margin="0,0,2,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.25*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="0.75*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource WorkspaceCardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                                           Text="扫描并更新图库" />
                                <TextBlock Margin="0,4,0,15"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Text="增量处理新增或变化的图片；未变化文件不会重复计算。" />

                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="目标图库" />
                                <ComboBox x:Name="IndexLibraryComboBox"
                                          Margin="0,0,0,13"
                                          Style="{StaticResource InputComboBoxStyle}"
                                          DisplayMemberPath="DisplayName"
                                          AutomationProperties.Name="索引目标图库" />

                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="本次新增文件的标签（空格分隔）" />
                                <TextBox x:Name="IndexTagsTextBox"
                                         Margin="0,0,0,5"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         AutomationProperties.Name="索引标签" />
                                <TextBlock Margin="0,0,0,13"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Text="仅应用于本次新增文件；已有文件（包括内容更新）会保留原标签。" />

                                <Border Margin="0,0,0,14"
                                        Style="{StaticResource InsetBorderStyle}">
                                    <StackPanel>
                                        <CheckBox x:Name="IndexRecursiveCheckBox"
                                                  IsChecked="True"
                                                  Content="递归扫描所有子目录" />
                                        <CheckBox x:Name="VerifyHashCheckBox"
                                                  Margin="0,10,0,0"
                                                  Content="强制校验文件哈希（更准确，耗时更长）" />
                                        <CheckBox x:Name="ClearTagsCheckBox"
                                                  Margin="0,10,0,0"
                                                  Content="清除当前图库全部人工标签（保留文件夹和已审核自动标签）" />
                                    </StackPanel>
                                </Border>

                                <CheckBox x:Name="IndexAndAutoTagCheckBox"
                                          Margin="0,0,0,9"
                                          Click="IndexAndAutoTagToggle_Click"
                                          Content="同时生成智能标签（仅本次新增）"
                                          AutomationProperties.Name="索引时同时生成智能标签" />
                                <Border Margin="0,0,0,14"
                                        Padding="11,10"
                                        Background="#FFF7ED"
                                        BorderBrush="#FED7AA"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Visibility="{Binding IsChecked, ElementName=IndexAndAutoTagCheckBox, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold"
                                                   Foreground="#9A5A13"
                                                   Text="组合任务设置 · 与智能整理页面同步" />
                                        <TextBlock Margin="0,3,0,9"
                                                   FontSize="10.5"
                                                   Foreground="#9A5A13"
                                                   Text="索引成功写入的本次新增图片会立即进入智能标注流水线；不会顺序提交两个任务。"
                                                   TextWrapping="Wrap" />
                                        <Grid Margin="0,0,0,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="0.8*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="0.8*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                                           Text="视觉模型" />
                                                <ComboBox x:Name="IndexAutoTagModelComboBox"
                                                          Style="{StaticResource InputComboBoxStyle}"
                                                          DisplayMemberPath="DisplayText"
                                                          SelectedIndex="{Binding SelectedIndex, ElementName=SmartTagModelComboBox, Mode=TwoWay}" />
                                                <TextBlock x:Name="IndexAutoTagModelPolicyTextBlock"
                                                           Margin="2,5,0,0"
                                                           FontSize="9.5"
                                                           Foreground="#9A5A13"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                                           Text="最多图片" />
                                                <TextBox Style="{StaticResource InputTextBoxStyle}"
                                                         Text="{Binding Text, ElementName=SmartTagMaxImagesTextBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                                           Text="费用上限（元）" />
                                                <TextBox Style="{StaticResource InputTextBoxStyle}"
                                                         Text="{Binding Text, ElementName=SmartTagBudgetTextBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>
                                        <CheckBox IsChecked="{Binding IsChecked, ElementName=ExternalProcessingConfirmCheckBox, Mode=TwoWay}"
                                                  Content="我确认本次新增图片会发送到第三方视觉模型处理"
                                                  AutomationProperties.Name="确认索引新增图片外发" />
                                    </StackPanel>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Margin="0,0,14,0"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextStyle}"
                                               Text="首次运行可能耗时较长，进度和详细输出可在“状态与诊断”的运行日志中查看。" />
                                    <Button x:Name="IndexActionButton"
                                            Grid.Column="1"
                                            MinWidth="142"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="Index_Click"
                                            Content="建立 / 更新索引" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource WorkspaceCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                                               Text="同步图库" />
                                    <TextBlock Margin="0,5,0,13"
                                               Style="{StaticResource CaptionTextStyle}"
                                               Text="识别磁盘上已删除的图片，并从 Collection 中移除对应记录。建议先预览。" />
                                    <Button Style="{StaticResource QuietButtonStyle}"
                                            Click="SyncPreview_Click"
                                            Content="预览待删除记录" />
                                    <Button Margin="0,8,0,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="Sync_Click"
                                            Content="执行同步" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,10,0,0"
                                    Style="{StaticResource InsetBorderStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SubsectionTitleTextStyle}"
                                               Text="什么时候需要同步？" />
                                    <TextBlock Margin="0,6,0,0"
                                               Style="{StaticResource CaptionTextStyle}"
                                               Text="日常新增照片只需更新索引。删除或大规模移动文件后，再执行图库同步。" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- Smart organization -->
            <TabItem x:Name="SmartTagsTabItem"
                     Header="③ 智能整理"
                     Loaded="SmartTagsTab_Loaded">
                <ScrollViewer Margin="0,9,0,0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <Grid Margin="0,0,2,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1.1*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Border Style="{StaticResource WorkspaceCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                                               Text="自动标注设置" />
                                    <TextBlock Margin="0,4,0,13"
                                               Style="{StaticResource CaptionTextStyle}"
                                               Text="先本地预览文件夹标签和预计费用，再决定是否把图片发送给视觉模型。" />

                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="目标图库" />
                                    <ComboBox x:Name="SmartTagLibraryComboBox"
                                              Margin="0,0,0,10"
                                              Style="{StaticResource InputComboBoxStyle}"
                                              DisplayMemberPath="DisplayName"
                                              AutomationProperties.Name="智能整理目标图库" />

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}"
                                                       Text="处理范围" />
                                            <ComboBox x:Name="SmartTagScopeComboBox"
                                                      Style="{StaticResource InputComboBoxStyle}"
                                                      SelectedIndex="1"
                                                      AutomationProperties.Name="自动标注处理范围">
                                                <ComboBoxItem Tag="latest_index_run"
                                                              Content="最近一次索引新增" />
                                                <ComboBoxItem Tag="untagged"
                                                              Content="尚未自动标注" />
                                                <ComboBoxItem Tag="failed"
                                                              Content="仅重试失败项" />
                                                <ComboBoxItem Tag="all"
                                                              Content="全部图片（复用已有缓存）" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}"
                                                       Text="视觉模型" />
                                            <ComboBox x:Name="SmartTagModelComboBox"
                                                      Style="{StaticResource InputComboBoxStyle}"
                                                      DisplayMemberPath="DisplayText"
                                                      SelectionChanged="SmartTagTaskModelSelectionChanged"
                                                      AutomationProperties.Name="自动标注视觉模型" />
                                            <TextBlock x:Name="SmartTagModelPolicyTextBlock"
                                                       Margin="2,5,0,0"
                                                       FontSize="9.5"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}"
                                                       Text="最多处理图片" />
                                            <TextBox x:Name="SmartTagMaxImagesTextBox"
                                                     Style="{StaticResource InputTextBoxStyle}"
                                                     Text="300"
                                                     AutomationProperties.Name="自动标注最大图片数" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}"
                                                       Text="费用上限（元）" />
                                            <TextBox x:Name="SmartTagBudgetTextBox"
                                                     Style="{StaticResource InputTextBoxStyle}"
                                                     Text="5.00"
                                                     AutomationProperties.Name="自动标注费用上限" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Margin="0,0,0,11"
                                            Padding="10,9"
                                            Background="#FFF7ED"
                                            BorderBrush="#FED7AA"
                                            BorderThickness="1"
                                            CornerRadius="9">
                                        <StackPanel>
                                            <CheckBox x:Name="ExternalProcessingConfirmCheckBox"
                                                      Content="我确认所选图片会发送到第三方视觉模型处理"
                                                      AutomationProperties.Name="确认图片外发" />
                                            <TextBlock Margin="24,5,0,0"
                                                       FontSize="10.5"
                                                       Foreground="#9A5A13"
                                                       Text="文件夹标签预览和补全完全在本地完成，不需要勾选；自动标注前必须明确确认。"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="7" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="SmartTagEstimate_Click"
                                                Content="预览标签与费用" />
                                        <Button Grid.Column="2"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Click="SmartTagStart_Click"
                                                Content="开始自动标注" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,10,0,0"
                                    Style="{StaticResource WorkspaceCardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                                                       Text="文件夹标签预览" />
                                            <TextBlock x:Name="SmartTagEstimateSummaryTextBlock"
                                                       Margin="0,4,0,0"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Text="尚未预览。数量、文件大小等技术信息会被移除。"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <Button MinWidth="106"
                                                    Style="{StaticResource QuietButtonStyle}"
                                                    Click="FolderTagBackfill_Click"
                                                    Content="补全历史图片" />
                                            <Button x:Name="MetadataBackfillButton"
                                                    MinWidth="106"
                                                    Margin="0,6,0,0"
                                                    Style="{StaticResource QuietButtonStyle}"
                                                    Click="MetadataBackfill_Click"
                                                    Content="生成描述向量"
                                                    ToolTip="使用已审核标签和短描述生成本地检索向量，不发送原图" />
                                        </StackPanel>
                                    </Grid>

                                    <ListBox x:Name="FolderTagPreviewListBox"
                                             Height="156"
                                             Margin="0,11,0,0"
                                             Padding="3"
                                             Background="{StaticResource SurfaceMutedBrush}"
                                             BorderBrush="{StaticResource BorderBrush}"
                                             BorderThickness="1"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             AutomationProperties.Name="文件夹标签预览列表">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="6,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="1*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               Text="{Binding SourceText}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding RelativePath}" />
                                                    <TextBlock Grid.Column="1"
                                                               Margin="8,0"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               Text="→" />
                                                    <TextBlock Grid.Column="2"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource PrimaryDarkBrush}"
                                                               Text="{Binding TagText}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,10,0,0"
                                    Style="{StaticResource WorkspaceCardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                                                       Text="标签别名词典" />
                                            <TextBlock x:Name="TagAliasSummaryTextBlock"
                                                       Margin="0,4,0,0"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Text="点击“加载”查看所有图库共用的别名词典。"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button MinWidth="58"
                                                    Style="{StaticResource CompactButtonStyle}"
                                                    Click="RefreshTagAliases_Click"
                                                    Content="加载" />
                                            <Button MinWidth="58"
                                                    Margin="6,0,0,0"
                                                    Style="{StaticResource CompactButtonStyle}"
                                                    Click="NewTagAlias_Click"
                                                    Content="新建" />
                                        </StackPanel>
                                    </Grid>

                                    <ListBox x:Name="TagAliasListBox"
                                             Height="112"
                                             Margin="0,10,0,0"
                                             Padding="3"
                                             Background="{StaticResource SurfaceMutedBrush}"
                                             BorderBrush="{StaticResource BorderBrush}"
                                             BorderThickness="1"
                                             SelectionChanged="TagAliasListBox_SelectionChanged"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling"
                                             AutomationProperties.Name="标签别名关系列表">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="6,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center"
                                                               FontSize="11"
                                                               Text="{Binding DisplayText}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding DisplayText}" />
                                                    <Button Grid.Column="1"
                                                            MinWidth="44"
                                                            Margin="8,0,0,0"
                                                            Style="{StaticResource CompactButtonStyle}"
                                                            Click="DeleteTagAlias_Click"
                                                            Content="删除" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.8*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="1.2*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}"
                                                       Text="规范名称" />
                                            <TextBox x:Name="TagAliasCanonicalTextBox"
                                                     Style="{StaticResource InputTextBoxStyle}"
                                                     ToolTip="例如：雷电将军"
                                                     AutomationProperties.Name="别名规范名称" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}"
                                                       Text="别名（空格或逗号分隔）" />
                                            <TextBox x:Name="TagAliasAliasesTextBox"
                                                     Style="{StaticResource InputTextBoxStyle}"
                                                     ToolTip="例如：雷神 影"
                                                     AutomationProperties.Name="标签别名列表" />
                                        </StackPanel>
                                    </Grid>
                                    <Button Margin="0,8,0,0"
                                            HorizontalAlignment="Right"
                                            MinWidth="96"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="SaveTagAlias_Click"
                                            Content="保存别名关系" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border Grid.Column="2"
                                Style="{StaticResource WorkspaceCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                                                   Text="审核模型建议" />
                                        <TextBlock x:Name="AutoTagReviewSummaryTextBlock"
                                                   Margin="0,4,0,0"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Text="自动标签默认不会覆盖人工标签；接受后才会进入有效标签。"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                     <StackPanel Grid.Column="1"
                                                 Orientation="Horizontal"
                                                 VerticalAlignment="Top">
                                         <TextBlock x:Name="AutoTagBatchSelectionTextBlock"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource CaptionTextStyle}"
                                                    Text="已选 0 张" />
                                         <Button MinWidth="82"
                                                 Style="{StaticResource CompactButtonStyle}"
                                                 Click="SelectAllLowRiskAutoTags_Click"
                                                 Content="全选低风险" />
                                         <Button MinWidth="68"
                                                 Margin="6,0,0,0"
                                                 Style="{StaticResource CompactButtonStyle}"
                                                 Click="ClearLowRiskAutoTagSelection_Click"
                                                 Content="清空选择" />
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Row="1"
                                        Margin="0,11,0,0"
                                        Padding="10"
                                        Background="{StaticResource SurfaceMutedBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="LatestIndexOnlyCheckBox"
                                                      Grid.Column="0"
                                                      VerticalAlignment="Bottom"
                                                      Margin="0,0,2,7"
                                                      Content="本次新增"
                                                      ToolTip="只看最近一次索引新增的图片" />
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                                           Text="角色" />
                                                <TextBox x:Name="AutoTagCharacterFilterTextBox"
                                                         Style="{StaticResource InputTextBoxStyle}"
                                                         ToolTip="支持规范名或别名" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                                           Text="作品" />
                                                <TextBox x:Name="AutoTagWorkFilterTextBox"
                                                         Style="{StaticResource InputTextBoxStyle}"
                                                         ToolTip="支持规范名或别名" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="6">
                                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                                           Text="状态" />
                                                <ComboBox x:Name="AutoTagReviewStateComboBox"
                                                          Style="{StaticResource InputComboBoxStyle}"
                                                          SelectedIndex="0">
                                                    <ComboBoxItem Tag="all" Content="全部待审核" />
                                                    <ComboBoxItem Tag="low_risk" Content="仅低风险" />
                                                    <ComboBoxItem Tag="identity" Content="含身份标签" />
                                                    <ComboBoxItem Tag="conflict" Content="冲突需确认" />
                                                    <ComboBoxItem Tag="failed" Content="标注失败（可手工补标）" />
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                                           Text="动作" />
                                                <TextBox x:Name="AutoTagActionFilterTextBox"
                                                         Style="{StaticResource InputTextBoxStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                                           Text="神态" />
                                                <TextBox x:Name="AutoTagExpressionFilterTextBox"
                                                         Style="{StaticResource InputTextBoxStyle}" />
                                            </StackPanel>
                                            <Button Grid.Column="4"
                                                    MinWidth="72"
                                                    VerticalAlignment="Bottom"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="ApplyAutoTagReviewFilters_Click"
                                                    Content="应用筛选" />
                                            <Button Grid.Column="6"
                                                    MinWidth="58"
                                                    VerticalAlignment="Bottom"
                                                    Style="{StaticResource QuietButtonStyle}"
                                                    Click="ClearAutoTagReviewFilters_Click"
                                                    Content="清空" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="2"
                                        Margin="0,9,0,10"
                                        Padding="10,8"
                                        Background="{StaticResource PrimarySoftBrush}"
                                        CornerRadius="9">
                                    <StackPanel>
                                        <ProgressBar x:Name="SmartTagProgressBar"
                                                     Height="5"
                                                     IsIndeterminate="False"
                                                     Foreground="{StaticResource PrimaryBrush}"
                                                     Background="#DDE5EF" />
                                        <TextBlock x:Name="SmartTagProgressTextBlock"
                                                   Margin="0,6,0,0"
                                                   FontSize="10.5"
                                                   Foreground="{StaticResource PrimaryDarkBrush}"
                                                   Text="等待任务"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>

                                <ListBox x:Name="AutoTagReviewListBox"
                                         Grid.Row="3"
                                         Height="520"
                                         Padding="2"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.CanContentScroll="True"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         AutomationProperties.Name="自动标签审核建议列表">
                                    <ListBox.Template>
                                        <ControlTemplate TargetType="ListBox">
                                            <ScrollViewer x:Name="PART_ScrollViewer"
                                                          Padding="{TemplateBinding Padding}"
                                                          Focusable="False"
                                                          CanContentScroll="True"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          VerticalScrollBarVisibility="Auto">
                                                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </ListBox.Template>
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                             <Border Margin="0,0,0,8"
                                                     Padding="11"
                                                     Background="{StaticResource SurfaceMutedBrush}"
                                                     BorderBrush="{StaticResource BorderBrush}"
                                                     BorderThickness="1"
                                                     CornerRadius="10">
                                                 <Grid>
                                                     <Grid.ColumnDefinitions>
                                                         <ColumnDefinition Width="96" />
                                                         <ColumnDefinition Width="10" />
                                                         <ColumnDefinition Width="*" />
                                                     </Grid.ColumnDefinitions>
                                                     <Border Grid.Column="0"
                                                             Width="96"
                                                             Height="96"
                                                             VerticalAlignment="Top"
                                                             Background="#E8EEF6"
                                                             BorderBrush="{StaticResource BorderBrush}"
                                                             BorderThickness="1"
                                                             CornerRadius="8"
                                                             ClipToBounds="True">
                                                         <Grid>
                                                             <TextBlock HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        FontSize="24"
                                                                        Foreground="#AAB8CA"
                                                                        Text="▧" />
                                                             <Image Source="{Binding Thumbnail}"
                                                                    Stretch="UniformToFill"
                                                                    Loaded="AutoTagThumbnail_Loaded"
                                                                    DataContextChanged="AutoTagThumbnail_DataContextChanged"
                                                                    ToolTip="{Binding SourcePath}"
                                                                    RenderOptions.BitmapScalingMode="HighQuality" />
                                                         </Grid>
                                                     </Border>
                                                     <StackPanel Grid.Column="2">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0"
                                                                  Margin="0,0,8,0"
                                                                  VerticalAlignment="Center"
                                                                  IsChecked="{Binding IsBatchSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  IsEnabled="{Binding CanBatchAccept}"
                                                                  Click="LowRiskAutoTagSelection_Click"
                                                                  Content="批量"
                                                                  ToolTip="只会批量接受低风险普通标签；安全身份已自动同意，冲突身份始终排除" />
                                                        <TextBlock Grid.Column="1"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Text="{Binding RelativePath}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding RelativePath}" />
                                                    </Grid>
                                                    <Border Margin="0,5,0,0"
                                                            Padding="8,5"
                                                            Background="White"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8">
                                                        <StackPanel>
                                                            <TextBlock FontSize="10.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource PrimaryDarkBrush}"
                                                                       Text="{Binding DifferenceSummary}" />
                                                            <TextBlock Margin="0,2,0,0"
                                                                       FontSize="10"
                                                                       Foreground="{StaticResource PrimaryDarkBrush}"
                                                                       Text="{Binding LowRiskTagsText, StringFormat=低风险：{0}}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding LowRiskTagsText}" />
                                                         </StackPanel>
                                                     </Border>
                                                    <Border Margin="0,6,0,0"
                                                            Padding="8,6"
                                                            Background="#FFF7ED"
                                                            BorderBrush="#FED7AA"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Visibility="{Binding HasIdentityTags, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <StackPanel>
                                                            <TextBlock FontSize="10.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#9A5A13"
                                                                       Text="仅身份冲突需要逐项确认（不会进入批量操作）" />
                                                            <ItemsControl Margin="0,4,0,0"
                                                                          ItemsSource="{Binding IdentityChoices}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <CheckBox Margin="0,0,12,4"
                                                                                  IsChecked="{Binding IsConfirmed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                  Content="{Binding DisplayText}" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                             </ItemsControl>
                                                         </StackPanel>
                                                     </Border>
                                                    <Grid Margin="0,6,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="7" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <ComboBox Grid.Column="0"
                                                                  MinWidth="92"
                                                                  Style="{StaticResource InputComboBoxStyle}"
                                                                  SelectedValue="{Binding Decision, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  SelectedValuePath="Tag">
                                                            <ComboBoxItem Tag="pending" Content="待决定" />
                                                            <ComboBoxItem Tag="accept" Content="接受" />
                                                            <ComboBoxItem Tag="manual" Content="保存人工标签" />
                                                            <ComboBoxItem Tag="reject" Content="拒绝" />
                                                        </ComboBox>
                                                        <TextBox Grid.Column="2"
                                                                 Style="{StaticResource InputTextBoxStyle}"
                                                                 Text="{Binding EditedTagsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 ToolTip="这里只编辑普通标签；身份标签请使用上方独立勾选框"
                                                                 AutomationProperties.Name="审核后的普通标签" />
                                                    </Grid>
                                                    <TextBlock Margin="0,5,0,0"
                                                               Padding="7,4"
                                                               Background="#FEF2F2"
                                                               Foreground="#991B1B"
                                                               Text="{Binding FailureText, StringFormat=失败原因：{0}}"
                                                               TextWrapping="Wrap"
                                                               Visibility="{Binding HasFailure, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <Expander Margin="0,5,0,0"
                                                              Header="标签与模型详情"
                                                              IsExpanded="{Binding IsDetailsExpanded, Mode=TwoWay}">
                                                        <StackPanel Margin="0,4,0,0">
                                                            <TextBlock FontSize="10.5"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       Text="{Binding Description}"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Margin="0,3,0,0"
                                                                       FontSize="10.5"
                                                                       Foreground="{StaticResource TextMutedBrush}"
                                                                       Text="{Binding ExistingTagsText, StringFormat=现有标签：{0}}"
                                                                       TextWrapping="Wrap" />
                                                            <ItemsControl Margin="0,5,0,0"
                                                                          ItemsSource="{Binding TagDetails}"
                                                                          Visibility="{Binding HasTagDetails, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Margin="0,0,5,5"
                                                                                Padding="6,2"
                                                                                Background="White"
                                                                                BorderBrush="{StaticResource BorderBrush}"
                                                                                BorderThickness="1"
                                                                                CornerRadius="7">
                                                                            <TextBlock FontSize="9.5"
                                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                                       Text="{Binding DisplayText}" />
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <TextBlock FontSize="10.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource PrimaryDarkBrush}"
                                                                       Text="{Binding StableFieldSummary, StringFormat=稳定字段：{0}}"
                                                                       TextWrapping="Wrap"
                                                                       Visibility="{Binding HasStableFields, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                            <TextBlock Margin="0,2,0,0"
                                                                       FontSize="10.5"
                                                                       Foreground="{StaticResource TextMutedBrush}"
                                                                       Text="{Binding StableFieldConfidenceText}"
                                                                       Visibility="{Binding HasStableFields, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                            <TextBlock Margin="0,3,0,0"
                                                                       FontSize="10.5"
                                                                       Foreground="{StaticResource PrimaryDarkBrush}"
                                                                       Text="{Binding EntitySummary}"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Margin="0,3,0,0"
                                                                       FontSize="10.5"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       Text="{Binding ModelPolicySummary}"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Margin="0,2,0,0"
                                                                       FontSize="10.5"
                                                                       Foreground="#9A5A13"
                                                                       Text="{Binding ReviewReasonsText}"
                                                                       TextWrapping="Wrap"
                                                                       Visibility="{Binding HasReviewReasons, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        </StackPanel>
                                                     </Expander>
                                                     </StackPanel>
                                                 </Grid>
                                             </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Grid Grid.Row="4" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            MinWidth="92"
                                            Style="{StaticResource QuietButtonStyle}"
                                            Click="RefreshAutoTagReview_Click"
                                            Content="恢复 / 刷新" />
                                    <TextBlock x:Name="AutoTagReviewPageTextBlock"
                                               Grid.Column="1"
                                               Margin="12,0"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Style="{StaticResource CaptionTextStyle}"
                                               Text="第 0 / 0 批" />
                                    <Button x:Name="PreviousAutoTagReviewPageButton"
                                            Grid.Column="2"
                                            MinWidth="68"
                                            IsEnabled="False"
                                            Style="{StaticResource QuietButtonStyle}"
                                            Click="PreviousAutoTagReviewPage_Click"
                                            Content="上一批" />
                                    <Button x:Name="NextAutoTagReviewPageButton"
                                            Grid.Column="3"
                                            MinWidth="68"
                                            Margin="6,0,0,0"
                                            IsEnabled="False"
                                            Style="{StaticResource QuietButtonStyle}"
                                            Click="NextAutoTagReviewPage_Click"
                                            Content="下一批" />
                                </Grid>

                                <Grid Grid.Row="5" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Margin="0,0,12,0"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextStyle}"
                                               Text="安全身份标签会自动同意；仅身份冲突需逐项确认，失败项可选择“保存人工标签”。"
                                               TextWrapping="Wrap" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="UndoAutoTagBatchButton"
                                                MinWidth="98"
                                                IsEnabled="False"
                                                Style="{StaticResource QuietButtonStyle}"
                                                Click="UndoAutoTagBatch_Click"
                                                Content="撤销最近批量" />
                                        <Button x:Name="AcceptSelectedLowRiskButton"
                                                MinWidth="118"
                                                Margin="6,0,0,0"
                                                IsEnabled="False"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="AcceptSelectedLowRiskAutoTags_Click"
                                                Content="接受所选低风险" />
                                        <Button MinWidth="108"
                                                Margin="6,0,0,0"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Click="SubmitAutoTagReview_Click"
                                                Content="提交逐项审核" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- Search -->
            <TabItem x:Name="SearchTabItem"
                     Header="④ 图片搜索">
                <ScrollViewer x:Name="SearchPageScrollViewer"
                              Margin="0,9,0,0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                <Grid Height="{Binding ViewportHeight, ElementName=SearchPageScrollViewer}"
                      MinHeight="260"
                      Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.72*" MinWidth="184" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="1.55*" MinWidth="224" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="0.62*" MinWidth="132" />
                    </Grid.ColumnDefinitions>

                    <GridSplitter Grid.Column="1"
                                  Style="{StaticResource ModernGridSplitterStyle}"
                                  ResizeDirection="Columns"
                                  ResizeBehavior="PreviousAndNext" />
                    <GridSplitter Grid.Column="3"
                                  Style="{StaticResource ModernGridSplitterStyle}"
                                  ResizeDirection="Columns"
                                  ResizeBehavior="PreviousAndNext" />

                    <!-- Query controls -->
                    <Border Grid.Column="0"
                            Padding="14"
                            Style="{StaticResource WorkspaceCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ScrollViewer Grid.Row="0"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                                           Text="检索条件" />
                                <TextBlock Margin="0,4,0,12"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Text="选择范围和模式，填写对应的文字或图片。" />

                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="图库范围" />
                                <ComboBox x:Name="SearchLibraryScopeComboBox"
                                          Margin="0,0,0,10"
                                          Style="{StaticResource InputComboBoxStyle}"
                                          DisplayMemberPath="DisplayName"
                                          AutomationProperties.Name="搜索图库范围" />

                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="检索模式" />
                                <ComboBox x:Name="SearchModeComboBox"
                                          Margin="0,0,0,10"
                                          Style="{StaticResource InputComboBoxStyle}"
                                          SelectedIndex="0"
                                          SelectionChanged="SearchModeComboBox_SelectionChanged"
                                          AutomationProperties.Name="检索模式">
                                    <ComboBoxItem Tag="text" Content="文字搜图" />
                                    <ComboBoxItem Tag="image" Content="以图搜图" />
                                    <ComboBoxItem Tag="mixed" Content="图文联合" />
                                </ComboBox>

                                <Border Margin="0,0,0,10"
                                        Padding="9,7"
                                        Background="{StaticResource PrimarySoftBrush}"
                                        CornerRadius="8">
                                    <TextBlock x:Name="SearchModeHintTextBlock"
                                               FontSize="11"
                                               Foreground="{StaticResource PrimaryDarkBrush}"
                                               Text="输入自然语言描述，查找语义相近的图片。"
                                               TextWrapping="Wrap" />
                                </Border>

                                <CheckBox x:Name="SemanticTextSearchCheckBox"
                                          Margin="0,0,0,10"
                                          IsChecked="True"
                                          Checked="SemanticTextSearchCheckBox_Changed"
                                          Unchecked="SemanticTextSearchCheckBox_Changed"
                                          Content="开启 AI 语义搜索"
                                          ToolTip="关闭后只匹配图库中已有的标签，不调用大模型。"
                                          AutomationProperties.Name="开启 AI 语义搜索" />

                                <StackPanel x:Name="SearchTextPanel">
                                    <TextBlock x:Name="SearchTextFieldLabel"
                                               Style="{StaticResource FieldLabelStyle}"
                                               Text="文字描述" />
                                    <TextBox x:Name="SearchTextBox"
                                             Height="62"
                                             Margin="0,0,0,10"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalContentAlignment="Top"
                                             AutomationProperties.Name="搜索文字描述" />
                                </StackPanel>

                                <StackPanel x:Name="SearchImagePanel">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}"
                                               Text="查询图片" />
                                    <Border x:Name="QueryImageDropZone"
                                            MinHeight="132"
                                            Margin="0,0,0,10"
                                            Padding="9"
                                            AllowDrop="True"
                                            Background="#F6F9FD"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Focusable="True"
                                            DragLeave="QueryImageDropZone_DragLeave"
                                            DragOver="QueryImageDropZone_DragOver"
                                            Drop="QueryImageDropZone_Drop"
                                            PreviewKeyDown="QueryImageDropZone_PreviewKeyDown"
                                            ToolTip="拖入图片或文件夹；聚焦后可按 Ctrl+V 粘贴"
                                            AutomationProperties.Name="查询图片投放区">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="82" />
                                                <ColumnDefinition Width="9" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Background="#E8EEF6"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <StackPanel x:Name="QueryImageInputPlaceholder"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center">
                                                        <TextBlock HorizontalAlignment="Center"
                                                                   FontSize="25"
                                                                   Foreground="#8394AA"
                                                                   Text="＋" />
                                                        <TextBlock Margin="3,2"
                                                                   FontSize="9.5"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   Text="添加图片"
                                                                   TextAlignment="Center" />
                                                    </StackPanel>
                                                    <Image x:Name="QueryImageInputPreviewImage"
                                                           Visibility="Collapsed"
                                                           Stretch="UniformToFill"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           Text="拖放、粘贴或选择查询图片" />
                                                <TextBlock x:Name="QueryImageInputStatusTextBlock"
                                                           Margin="0,3,0,6"
                                                           FontSize="10"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           Text="拖入图片或文件夹，也可以从剪贴板粘贴。"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                                <WrapPanel Margin="0,0,-5,-5">
                                                    <Button x:Name="ChooseQueryImageButton"
                                                            MinWidth="66"
                                                            Margin="0,0,5,5"
                                                            Style="{StaticResource CompactButtonStyle}"
                                                            Click="BrowseQueryImage_Click"
                                                            Content="选择图片"
                                                            AutomationProperties.Name="选择查询图片" />
                                                    <Button x:Name="PasteQueryImageButton"
                                                            MinWidth="54"
                                                            Margin="0,0,5,5"
                                                            Style="{StaticResource CompactButtonStyle}"
                                                            Click="PasteQueryImage_Click"
                                                            Content="粘贴"
                                                            AutomationProperties.Name="粘贴查询图片" />
                                                    <Button x:Name="BrowseQueryImageDirectoryButton"
                                                            MinWidth="66"
                                                            Margin="0,0,5,5"
                                                            Style="{StaticResource CompactButtonStyle}"
                                                            Click="BrowseQueryImageDirectory_Click"
                                                            Content="目录选图"
                                                            AutomationProperties.Name="从目录选择查询图片" />
                                                    <Button x:Name="ClearQueryImageButton"
                                                            MinWidth="42"
                                                            Margin="0,0,5,5"
                                                            Style="{StaticResource QuietButtonStyle}"
                                                            Click="ClearQueryImage_Click"
                                                            Content="清除"
                                                            AutomationProperties.Name="清除查询图片" />
                                                </WrapPanel>
                                                <TextBox x:Name="QueryImageTextBox"
                                                         Height="27"
                                                         Margin="0,5,0,0"
                                                         IsReadOnly="True"
                                                         Style="{StaticResource InputTextBoxStyle}"
                                                         TextChanged="QueryImageTextBox_TextChanged"
                                                         AutomationProperties.Name="查询图片路径" />
                                            </StackPanel>

                                            <Border x:Name="QueryImageDropOverlay"
                                                    Grid.ColumnSpan="3"
                                                    Margin="-4"
                                                    Padding="8"
                                                    Visibility="Collapsed"
                                                    Background="#E8F2FF"
                                                    BorderBrush="{StaticResource PrimaryBrush}"
                                                    BorderThickness="2"
                                                    CornerRadius="10"
                                                    IsHitTestVisible="False">
                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource PrimaryDarkBrush}"
                                                           Text="松开即可使用这张图片"
                                                           TextAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="1.2*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                                   Text="返回数量" />
                                        <TextBox x:Name="TopKTextBox"
                                                 Style="{StaticResource InputTextBoxStyle}"
                                                 Text="15"
                                                 AutomationProperties.Name="返回数量" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                                   Text="标签匹配" />
                                        <ComboBox x:Name="TagModeComboBox"
                                                  Style="{StaticResource InputComboBoxStyle}"
                                                  SelectedIndex="0"
                                                  AutomationProperties.Name="标签匹配方式">
                                            <ComboBoxItem Tag="all" Content="全部标签" />
                                            <ComboBoxItem Tag="any" Content="任一标签" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="筛选标签（默认包含匹配，空格分隔）" />
                                <TextBox x:Name="SearchTagsTextBox"
                                         Margin="0,0,0,4"
                                         Style="{StaticResource InputTextBoxStyle}"
                                         AutomationProperties.Name="搜索筛选标签" />
                                <TextBlock Margin="0,0,0,10"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Text="输入“原”或“神”都能命中“原神”；多个词按上方“全部 / 任一”组合。"
                                           TextWrapping="Wrap" />

                                <Grid x:Name="SearchWeightPanel" Margin="0,0,0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                                   Text="图片权重" />
                                        <TextBox x:Name="ImageWeightTextBox"
                                                 Style="{StaticResource InputTextBoxStyle}"
                                                 Text="0.5"
                                                 AutomationProperties.Name="图片权重" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                                   Text="文字权重" />
                                        <TextBox x:Name="TextWeightTextBox"
                                                 Style="{StaticResource InputTextBoxStyle}"
                                                 Text="0.5"
                                                 AutomationProperties.Name="文字权重" />
                                    </StackPanel>
                                </Grid>

                                <CheckBox x:Name="IncludeSelfCheckBox"
                                          Margin="0,0,0,7"
                                          Content="包含查询图片本身" />

                                <CheckBox x:Name="DiversifyResultsCheckBox"
                                          Margin="0,0,0,7"
                                          IsChecked="True"
                                          Content="优先展示不同套图（前 20 张每套最多 2 张）"
                                          ToolTip="关闭后恢复原始相关性顺序，适合连续查看同一套图片。"
                                          AutomationProperties.Name="优先展示不同套图" />

                                <CheckBox x:Name="ShowLowConfidenceCheckBox"
                                          Margin="0,0,0,11"
                                          IsEnabled="False"
                                          Content="显示低置信候选（不可信）"
                                          ToolTip="常驻后端启动后将检测是否支持该诊断功能。"
                                          AutomationProperties.Name="显示低置信候选" />

                                </StackPanel>
                            </ScrollViewer>
                            <Button Grid.Row="1"
                                    Margin="0,10,0,0"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="Search_Click"
                                    Content="开始搜索" />
                        </Grid>
                    </Border>

                    <!-- Result gallery -->
                    <Border Grid.Column="2"
                            Padding="14"
                            Style="{StaticResource WorkspaceCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Margin="2,0,2,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                                               Text="检索结果" />
                                    <TextBlock x:Name="ResultsSummaryTextBlock"
                                               Margin="0,3,0,0"
                                               Style="{StaticResource CaptionTextStyle}"
                                               Text="尚未执行搜索"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <CheckBox x:Name="DiagnosticScoreCheckBox"
                                              Margin="0,0,9,0"
                                              VerticalAlignment="Center"
                                              Content="诊断分数"
                                              ToolTip="显示原始分数、归一化分数和校准置信度" />
                                    <Button Style="{StaticResource CompactButtonStyle}"
                                            Click="ReloadResults_Click"
                                            Content="重载"
                                            ToolTip="重新载入最新搜索结果" />
                                </StackPanel>
                            </Grid>

                            <ListBox x:Name="ResultsList"
                                     Grid.Row="1"
                                     Padding="2"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemContainerStyle="{StaticResource ResultListItemStyle}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     SelectionChanged="ResultsList_SelectionChanged"
                                     MouseDoubleClick="ResultsList_MouseDoubleClick"
                                     AutomationProperties.Name="搜索结果列表">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:VirtualizingWrapPanel ItemWidth="160"
                                                                              ItemHeight="236"
                                                                              ExactFillItemCount="15"
                                                                              StretchItemsToViewport="True" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinWidth="136"
                                              MinHeight="204"
                                              ClipToBounds="True">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="0.58*" />
                                                <RowDefinition Height="0.42*" />
                                            </Grid.RowDefinitions>
                                            <Border Background="#E8EEF6"
                                                    CornerRadius="9,9,0,0"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <TextBlock HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontSize="29"
                                                               Foreground="#AAB8CA"
                                                               Text="▧" />
                                                    <Image Source="{Binding Thumbnail}"
                                                           Stretch="UniformToFill"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                    <Border Margin="7"
                                                            Padding="6,3"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Top"
                                                            Background="#D9142238"
                                                            CornerRadius="8">
                                                        <TextBlock FontSize="10.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="White"
                                                                   Text="{Binding Rank, StringFormat='#{0}'}" />
                                                    </Border>
                                                    <Border Margin="7"
                                                            Padding="6,3"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Background="#D90F766E"
                                                            CornerRadius="8">
                                                        <TextBlock MaxWidth="78"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="White"
                                                                   Text="{Binding LibraryText}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Row="1" Margin="9,7">
                                                <TextBlock FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding FullPath}" />
                                                <TextBlock Margin="0,3,0,0"
                                                           FontSize="10.5"
                                                           Text="{Binding ScoreText}"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock"
                                                               BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Setter Property="Foreground"
                                                                    Value="{StaticResource TextMutedBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding MatchState}"
                                                                             Value="high">
                                                                    <Setter Property="Foreground"
                                                                            Value="{StaticResource SuccessBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding MatchState}"
                                                                             Value="possible">
                                                                    <Setter Property="Foreground"
                                                                            Value="{StaticResource WarningBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding MatchState}"
                                                                             Value="weak">
                                                                    <Setter Property="Foreground"
                                                                            Value="{StaticResource DangerBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsLowConfidenceOverride}"
                                                                             Value="True">
                                                                    <Setter Property="Foreground"
                                                                            Value="{StaticResource DangerBrush}" />
                                                                    <Setter Property="FontWeight"
                                                                            Value="SemiBold" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}"
                                                                             Value="True">
                                                                    <Setter Property="Foreground"
                                                                            Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="9.5"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           Text="{Binding DiagnosticScoreText}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding DiagnosticScoreText}"
                                                           Visibility="{Binding IsChecked, ElementName=DiagnosticScoreCheckBox, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="10"
                                                           Foreground="#0F766E"
                                                           Text="{Binding LibraryText}"
                                                           TextTrimming="CharacterEllipsis" />
                                                 <TextBlock Margin="0,2,0,0"
                                                            FontSize="10"
                                                            Foreground="{StaticResource TextMutedBrush}"
                                                            Text="{Binding TagsText}"
                                                            TextTrimming="CharacterEllipsis" />
                                                 <TextBlock Margin="0,2,0,0"
                                                            FontSize="10"
                                                            FontWeight="SemiBold"
                                                            Foreground="{StaticResource PrimaryDarkBrush}"
                                                            Text="{Binding MatchedTagsText}"
                                                            TextTrimming="CharacterEllipsis"
                                                            ToolTip="{Binding MatchedTagsText}"
                                                            Visibility="{Binding HasMatchedTags, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                             </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Grid.Row="1"
                                    Margin="3"
                                    Padding="12">
                                <Border.Style>
                                    <Style TargetType="Border"
                                           BasedOn="{StaticResource EmptyStateBorderStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasItems, ElementName=ResultsList}"
                                                         Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource EmptyStateIconTextStyle}"
                                               Text="&#xE721;" />
                                    <TextBlock x:Name="ResultsEmptyTitleTextBlock"
                                               Style="{StaticResource EmptyStateTitleTextStyle}"
                                               Text="暂无检索结果" />
                                    <TextBlock x:Name="ResultsEmptyCaptionTextBlock"
                                                MaxWidth="230"
                                                Style="{StaticResource EmptyStateCaptionTextStyle}"
                                                Text="填写左侧条件开始搜索，或调整范围与关键词后重试。" />
                                    <Button x:Name="ResultsShowLowConfidenceButton"
                                            Margin="0,12,0,0"
                                            Style="{StaticResource CompactButtonStyle}"
                                            Click="ShowLowConfidenceResults_Click"
                                            Content="显示低置信候选（不可信）"
                                            ToolTip="重新搜索并显示低置信候选；结果仅供诊断。"
                                            Visibility="Collapsed"
                                            AutomationProperties.Name="显示低置信候选" />
                                </StackPanel>
                            </Border>

                            <Grid x:Name="ResultsPaginationPanel"
                                  Grid.Row="2"
                                  Margin="2,10,2,0"
                                  Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PreviousResultsPageButton"
                                        Grid.Column="0"
                                        MinWidth="72"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource CompactButtonStyle}"
                                        Click="PreviousResultsPage_Click"
                                        Content="上一页"
                                        AutomationProperties.Name="上一页搜索结果" />
                                <TextBlock x:Name="ResultsPageTextBlock"
                                           Grid.Column="1"
                                           MinWidth="132"
                                           Margin="12,0"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Text="第 1 / 1 页" />
                                <Button x:Name="NextResultsPageButton"
                                        Grid.Column="2"
                                        MinWidth="72"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource CompactButtonStyle}"
                                        Click="NextResultsPage_Click"
                                        Content="下一页"
                                        AutomationProperties.Name="下一页搜索结果" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Selected result preview -->
                    <Border Grid.Column="4"
                            Padding="12"
                            Style="{StaticResource WorkspaceCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="0.48*" />
                                <RowDefinition Height="0.52*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Margin="1,0,1,8"
                                       Style="{StaticResource SectionTitleTextStyle}"
                                       Text="预览" />

                            <Border Grid.Row="1"
                                    Margin="0,0,0,9"
                                    Background="#E8EEF6"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    ClipToBounds="True">
                                <Grid>
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="32"
                                               Foreground="#AAB8CA"
                                               Text="▧" />
                                    <Image x:Name="SelectedPreviewImage"
                                           Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="2"
                                          Margin="1,0,1,8"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock x:Name="SelectedNameText"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Text="请选择结果图片"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="SelectedScoreText"
                                               Margin="0,5,0,0"
                                               FontSize="11.5"
                                               Foreground="{StaticResource PrimaryDarkBrush}"
                                               Text="—" />
                                    <TextBlock x:Name="SelectedDiagnosticScoreText"
                                               Margin="0,3,0,0"
                                               FontSize="10.5"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="—"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding IsChecked, ElementName=DiagnosticScoreCheckBox, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Margin="0,9,0,2"
                                               Style="{StaticResource FieldLabelStyle}"
                                               Text="图库" />
                                    <TextBlock x:Name="SelectedLibraryText"
                                               Style="{StaticResource CaptionTextStyle}"
                                               Text="—" />
                                    <TextBlock Margin="0,8,0,2"
                                               Style="{StaticResource FieldLabelStyle}"
                                               Text="标签" />
                                    <TextBlock x:Name="SelectedTagsText"
                                               Style="{StaticResource CaptionTextStyle}"
                                               Text="—" />
                                    <TextBlock Margin="0,8,0,2"
                                               Style="{StaticResource FieldLabelStyle}"
                                               Text="相对路径" />
                                    <TextBlock x:Name="SelectedPathText"
                                               Style="{StaticResource CaptionTextStyle}"
                                               Text="—"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </ScrollViewer>

                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        MinWidth="0"
                                        Style="{StaticResource CompactButtonStyle}"
                                        Click="OpenSelected_Click"
                                        Content="打开"
                                        ToolTip="打开所选图片" />
                                <Button Grid.Column="2"
                                        MinWidth="0"
                                        Style="{StaticResource CompactButtonStyle}"
                                        Click="OpenSelectedFolder_Click"
                                        Content="目录"
                                        ToolTip="打开所选图片所在目录" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- Diagnostics -->
            <TabItem x:Name="StatusDiagnosticsTabItem"
                     Header="⑤ 状态与诊断">
                <ScrollViewer Margin="0,9,0,0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,2,2">
                        <!-- Background work and logs live here instead of reserving
                             height under every workspace tab. -->
                        <Border Padding="14"
                                Style="{StaticResource WorkspaceCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7"
                                                     Height="7"
                                                     Margin="0,0,7,0"
                                                     VerticalAlignment="Center"
                                                     Fill="{StaticResource AccentBrush}" />
                                            <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                                                       Text="后台任务" />
                                        </StackPanel>
                                        <TextBlock x:Name="TaskCenterSummaryTextBlock"
                                                   Margin="0,4,0,0"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Text="没有运行中的任务"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1"
                                               Margin="0,0,-6,-6"
                                               HorizontalAlignment="Right">
                                        <Button MinWidth="78"
                                                Margin="0,0,6,6"
                                                Style="{StaticResource CompactButtonStyle}"
                                                Click="ClearLog_Click"
                                                Content="清空日志" />
                                        <Button x:Name="CancelButton"
                                                MinWidth="96"
                                                Margin="0,0,6,6"
                                                IsEnabled="False"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Click="Cancel_Click"
                                                Content="取消前台任务" />
                                    </WrapPanel>
                                </Grid>

                                <Expander x:Name="TaskLogExpander"
                                          Grid.Row="1"
                                          Margin="0,8,0,0"
                                          HorizontalContentAlignment="Stretch"
                                          Header="任务详情与运行日志"
                                          IsExpanded="False">
                                    <StackPanel Margin="0,7,0,1">
                                        <ListBox x:Name="BackendTaskList"
                                                 MaxHeight="260"
                                                 Padding="0"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 ScrollViewer.CanContentScroll="True"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                                 AutomationProperties.Name="后台任务列表">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <VirtualizingStackPanel />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0,0,0,5" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="9,7"
                                                            Background="{StaticResource SurfaceMutedBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>

                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Grid Grid.Column="0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock MaxWidth="170"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                                               Text="{Binding Title}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Grid.Column="1"
                                                                               Margin="8,0,0,0"
                                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                                               Text="{Binding StatusText}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Grid.Column="2"
                                                                               Margin="8,0,0,0"
                                                                               Foreground="{StaticResource TextMutedBrush}"
                                                                               Text="{Binding LibraryText}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </Grid>
                                                                <StackPanel Grid.Column="1"
                                                                            Margin="8,0,0,0"
                                                                            Orientation="Horizontal">
                                                                    <Button MinWidth="86"
                                                                            Margin="0,0,6,0"
                                                                            Padding="8,2"
                                                                            IsEnabled="{Binding CanOpenFailureDirectory}"
                                                                            Visibility="{Binding CanOpenFailureDirectory, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                            CommandParameter="{Binding Id}"
                                                                            Style="{StaticResource CompactButtonStyle}"
                                                                            Click="OpenFailureDirectory_Click"
                                                                            Content="打开失败目录" />
                                                                    <Button MinWidth="54"
                                                                            Padding="8,2"
                                                                            IsEnabled="{Binding CanCancel}"
                                                                            CommandParameter="{Binding Id}"
                                                                            Style="{StaticResource DangerButtonStyle}"
                                                                            Click="CancelBackendTask_Click"
                                                                            Content="取消" />
                                                                </StackPanel>
                                                            </Grid>

                                                            <Grid Grid.Row="1" Margin="0,4,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock FontSize="11"
                                                                           Foreground="{StaticResource TextMutedBrush}"
                                                                           Text="{Binding Message}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Grid.Column="1"
                                                                           Margin="10,0,0,0"
                                                                           FontSize="11"
                                                                           Foreground="{StaticResource TextMutedBrush}"
                                                                           Text="{Binding ProgressText}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </Grid>
                                                            <ProgressBar Grid.Row="2"
                                                                         Height="4"
                                                                         Margin="0,6,0,0"
                                                                         Maximum="{Binding ProgressMaximum, Mode=OneWay}"
                                                                         Value="{Binding ProgressValue, Mode=OneWay}"
                                                                         IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                                                         Foreground="{StaticResource PrimaryBrush}"
                                                                         Background="#DDE5EF" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Expander x:Name="RuntimeLogExpander"
                                                  Margin="0,3,0,0"
                                                  Header="运行日志"
                                                  IsExpanded="False">
                                            <TextBox x:Name="LogTextBox"
                                                     Height="160"
                                                     Margin="0,6,0,0"
                                                     Style="{StaticResource OutputTextBoxStyle}"
                                                     TextWrapping="NoWrap"
                                                     AutomationProperties.Name="任务日志" />
                                        </Expander>
                                    </StackPanel>
                                </Expander>
                            </Grid>
                        </Border>

                        <Grid MinHeight="250" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Padding="15"
                                    Style="{StaticResource WorkspaceCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                                                   Text="Collection 统计" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Text="文档数量、索引状态、根目录和查询缓存。" />
                                    </StackPanel>
                                    <TextBox x:Name="StatsOutputTextBox"
                                             Grid.Row="1"
                                             MinHeight="132"
                                             Margin="0,0,0,9"
                                             Style="{StaticResource OutputTextBoxStyle}"
                                             Text="尚未读取统计信息。" />
                                    <WrapPanel Grid.Row="2" Margin="0,0,-6,-6">
                                        <Button MinWidth="86"
                                                Margin="0,0,6,6"
                                                Style="{StaticResource QuietButtonStyle}"
                                                Click="Stats_Click"
                                                Content="刷新统计" />
                                        <Button MinWidth="96"
                                                Margin="0,0,6,6"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="CacheClear_Click"
                                                Content="清除缓存" />
                                        <Button MinWidth="96"
                                                Margin="0,0,6,6"
                                                Style="{StaticResource QuietButtonStyle}"
                                                Click="CleanPreview_Click"
                                                Content="预览清理" />
                                        <Button MinWidth="96"
                                                Margin="0,0,6,6"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Click="Clean_Click"
                                                Content="清理旧结果" />
                                    </WrapPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2"
                                    Padding="15"
                                    Style="{StaticResource WorkspaceCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                                                   Text="运行环境诊断" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Text="检查原生 Python 后端、目录权限和 API Key。" />
                                    </StackPanel>
                                    <TextBox x:Name="DoctorOutputTextBox"
                                             Grid.Row="1"
                                             MinHeight="132"
                                             Margin="0,0,0,9"
                                             Style="{StaticResource OutputTextBoxStyle}"
                                             Text="尚未执行环境检查。" />
                                    <WrapPanel Grid.Row="2" Margin="0,0,-6,-6">
                                        <Button MinWidth="96"
                                                Margin="0,0,6,6"
                                                Style="{StaticResource QuietButtonStyle}"
                                                Click="Doctor_Click"
                                                Content="重新检查" />
                                        <Button MinWidth="96"
                                                Margin="0,0,6,6"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="OpenResults_Click"
                                                Content="结果目录" />
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Extensible Aliyun DashScope model-role configuration -->
            <TabItem x:Name="ModelConfigurationTabItem"
                     Header="⑥ 模型配置"
                     Loaded="ModelConfigurationTab_Loaded">
                <ScrollViewer Margin="0,9,0,0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,2,2">
                        <Border Padding="16"
                                Style="{StaticResource WorkspaceCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                                               Text="阿里云 DashScope 模型角色" />
                                    <TextBlock Margin="0,4,0,0"
                                               Style="{StaticResource CaptionTextStyle}"
                                               Text="这里只保存模型目录与角色映射。API Key 不会写入此文件，仍由 Windows 凭据管理器保护。"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,5,0,0"
                                               FontSize="10.5"
                                               Foreground="{StaticResource WarningBrush}"
                                               Text="更换向量模型只影响新建或重建索引；已有 Collection 的模型元数据不一致时会拒绝打开，防止混用不同向量。"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="ModelConfigurationPathTextBlock"
                                               Margin="0,8,0,0"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="10.5"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                </StackPanel>
                                <WrapPanel Grid.Column="1"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center">
                                    <Button x:Name="OpenModelConfigurationButton"
                                            MinWidth="82"
                                            Margin="0,0,6,0"
                                            Style="{StaticResource QuietButtonStyle}"
                                            Click="OpenModelConfiguration_Click"
                                            Content="打开 JSON" />
                                    <Button x:Name="ReloadModelConfigurationButton"
                                            MinWidth="72"
                                            Margin="0,0,6,0"
                                            Style="{StaticResource QuietButtonStyle}"
                                            Click="ReloadModelConfiguration_Click"
                                            Content="重新载入" />
                                    <Button x:Name="SaveModelConfigurationButton"
                                            MinWidth="72"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="SaveModelConfiguration_Click"
                                            Content="保存角色" />
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <Border Margin="0,10,0,0"
                                Padding="12,9"
                                Background="{StaticResource SurfaceMutedBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9">
                            <TextBlock x:Name="ModelConfigurationStatusTextBlock"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="正在读取模型配置…"
                                       TextWrapping="Wrap" />
                        </Border>

                        <Border Margin="0,10,0,0"
                                Padding="16"
                                Style="{StaticResource WorkspaceCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SubsectionTitleTextStyle}"
                                               Text="向量模型" />
                                    <TextBlock Margin="0,4,0,0"
                                               Style="{StaticResource CaptionTextStyle}"
                                               Text="建立索引与图文语义搜索" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <ComboBox x:Name="EmbeddingModelComboBox"
                                              Style="{StaticResource InputComboBoxStyle}"
                                              DisplayMemberPath="DisplayText"
                                              SelectionChanged="ModelRoleSelectionChanged"
                                              AutomationProperties.Name="向量模型" />
                                    <TextBlock x:Name="EmbeddingModelDetailsTextBlock"
                                               Margin="2,7,0,0"
                                               FontSize="10.5"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Margin="0,10,0,0"
                                Padding="16"
                                Style="{StaticResource WorkspaceCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SubsectionTitleTextStyle}"
                                               Text="常规智能标注" />
                                    <TextBlock Margin="0,4,0,0"
                                               Style="{StaticResource CaptionTextStyle}"
                                               Text="优先处理大多数图片，兼顾速度和成本" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <ComboBox x:Name="AutoTagPrimaryModelComboBox"
                                              Style="{StaticResource InputComboBoxStyle}"
                                              DisplayMemberPath="DisplayText"
                                              SelectionChanged="ModelRoleSelectionChanged"
                                              AutomationProperties.Name="常规智能标注模型" />
                                    <TextBlock x:Name="AutoTagPrimaryModelDetailsTextBlock"
                                               Margin="2,7,0,0"
                                               FontSize="10.5"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Margin="0,10,0,0"
                                Padding="16"
                                Style="{StaticResource WorkspaceCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SubsectionTitleTextStyle}"
                                               Text="疑难升级标注" />
                                    <TextBlock Margin="0,4,0,0"
                                               Style="{StaticResource CaptionTextStyle}"
                                               Text="身份或角色不确定时使用更强模型复核" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <ComboBox x:Name="AutoTagEscalationModelComboBox"
                                              Style="{StaticResource InputComboBoxStyle}"
                                              DisplayMemberPath="DisplayText"
                                              SelectionChanged="ModelRoleSelectionChanged"
                                              AutomationProperties.Name="疑难升级标注模型" />
                                    <TextBlock x:Name="AutoTagEscalationModelDetailsTextBlock"
                                               Margin="2,7,0,0"
                                               FontSize="10.5"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Operation status -->
        <Grid Grid.Row="3" Margin="2,5,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="128" />
                <ColumnDefinition Width="9" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="BusyProgressBar"
                         Grid.Column="0"
                         Height="5"
                         VerticalAlignment="Center"
                         IsIndeterminate="True"
                         Visibility="Collapsed"
                         Foreground="{StaticResource PrimaryBrush}"
                         Background="#DDE5EF" />
            <TextBlock x:Name="StatusTextBlock"
                       Grid.Column="2"
                       VerticalAlignment="Center"
                       FontSize="11.5"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="就绪"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="3"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="10.5"
                       Foreground="{StaticResource TextMutedBrush}"
                       Text="Zvec Desktop · Multi-Collection" />
        </Grid>
    </Grid>
</Window>
