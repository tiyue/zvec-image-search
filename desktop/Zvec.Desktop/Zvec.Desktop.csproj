<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Zvec.Desktop</RootNamespace>
    <AssemblyName>Zvec.Desktop</AssemblyName>
    <Version>0.4.0</Version>
    <AssemblyVersion>0.4.0.0</AssemblyVersion>
    <FileVersion>0.4.0.0</FileVersion>
    <InformationalVersion>0.4.0</InformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Zvec.AppIcon.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Zvec.AppIcon.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- NotifyIcon is the only WinForms surface in the application. Referencing
         the Windows Forms desktop framework directly avoids changing WPF's DPI
         manifest and avoids WinForms global usings across the project. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\scripts\zvec.ps1"
             Link="scripts\zvec.ps1"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <!-- The desktop host launches this source tree with a user-scoped isolated Python.
         Keeping the source under backend/ gives source builds and installed packages
         the same deterministic entry-point layout without claiming Python is bundled. -->
    <Content Include="..\..\image_service.py"
             Link="backend\image_service.py"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\zvec_logging.py"
             Link="backend\zvec_logging.py"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\zvec_launcher.py"
             Link="backend\zvec_launcher.py"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\pyproject.toml"
             Link="backend\pyproject.toml"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\requirements.txt"
             Link="backend\requirements.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\requirements-lock.txt"
             Link="backend\requirements-lock.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\model-catalog.default.json"
             Link="backend\model-catalog.default.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\README.md"
             Link="backend\README.md"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\image_vector_service\**\*.py"
             Link="backend\image_vector_service\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
